{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "/I${workspaceFolder}\\include",
                "${file}",
                "${workspaceFolder}\\src\\glad.c",
                "/link",
                "/LIBPATH:${workspaceFolder}\\lib",
                "glfw3dll.lib",
                "opengl32.lib",
                "user32.lib",
                "gdi32.lib",
                "shell32.lib"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "dependsOn": "Copy GLFW runtime",
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "shell",
            "label": "Copy GLFW runtime",
            "command": "cmd.exe",
            "args": [
                "/c",
                "copy",
                "/Y",
                "${workspaceFolder}\\lib\\glfw3.dll",
                "${workspaceFolder}\\src\\glfw3.dll"
            ],
            "problemMatcher": []
        }
    ],
    "version": "2.0.0"
}